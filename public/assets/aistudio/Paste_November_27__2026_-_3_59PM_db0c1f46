6. Orquestrador do Agente NexPulse (Loop de Ferramentas + Guardrail de Saída + Structured Outputs)
app/agent/nexpulse_agent.py
Note que para gemini-3.8-flash, utilizamos thinking_config=types.ThinkingConfig(thinking_level="low") (sem parâmetros legados como temperature)[4][5] e executamos um loop controlado de ferramentas assíncronas com client.aio.models.generate_content[6].
Python
import json
import re
import uuid
from typing import Any, List, Tuple
import structlog
from google import genai
from google.genai import types
from redis.asyncio import Redis
from sqlalchemy.ext.asyncio import AsyncSession

from app.agent.prompts import NEXPULSE_SYSTEM_PROMPT
from app.agent.schemas import (
    OneClickStopClassification,
    PredictiveHealthReport,
)
from app.agent.tools import TOOL_DECLARATIONS, NexPulseReadOnlyTools
from app.core.config import settings

logger = structlog.get_logger()

# Padrões bloqueados caso o modelo tente sugerir escrita direta/bypass no CLP
FORBIDDEN_OT_PATTERNS = [
    r"\bforce\s*(i/o|bit|coil|tag)\b",
    r"\bbypass\s*(cortina|segurança|interlock|emergência)\b",
    r"\bescrever\s+diretamente\s+no\s+clp\b",
    r"\bwrite_register\b",
]


class NexPulseAgentService:
    def __init__(self, db: AsyncSession, redis: Redis) -> None:
        if not settings.GEMINI_API_KEY:
            raise RuntimeError("GEMINI_API_KEY não configurada no ambiente.")
        self.client = genai.Client(api_key=settings.GEMINI_API_KEY)
        self.tools_impl = NexPulseReadOnlyTools(db=db, redis=redis)
        self.redis = redis

    async def _dispatch_tool(self, name: str, args: dict) -> dict:
        method = getattr(self.tools_impl, name, None)
        if method is None:
            return {"error": f"Ferramenta não autorizada ou inexistente: {name}"}
        return await method(**args)

    def _apply_ot_safety_guardrail(self, text: str) -> str:
        for pattern in FORBIDDEN_OT_PATTERNS:
            if re.search(pattern, text, flags=re.IGNORECASE):
                logger.warning("ot_safety_guardrail_triggered", pattern=pattern)
                return (
                    text
                    + "\n\n> ⚠️ **Aviso de Segurança OT:** Nenhuma alteração física ou escrita de parâmetro no CLP/robô "
                    "deve ser executada sem bloqueio/validação presencial da engenharia de automação."
                )
        return text

    async def _run_agent_loop(
        self, initial_prompt: str, history_contents: List[types.Content] | None = None
    ) -> Tuple[str, List[str], List[str]]:
        contents: List[types.Content] = list(history_contents or [])
        contents.append(types.Content(role="user", parts=[types.Part.from_text(text=initial_prompt)]))

        tools_used: List[str] = []
        missing_flags: List[str] = []

        config = types.GenerateContentConfig(
            system_instruction=NEXPULSE_SYSTEM_PROMPT,
            tools=[types.Tool(function_declarations=TOOL_DECLARATIONS)],
            thinking_config=types.ThinkingConfig(thinking_level="low"),
        )

        for _ in range(settings.AGENT_MAX_TOOL_TURNS):
            response = await self.client.aio.models.generate_content(
                model=settings.GEMINI_MODEL,
                contents=contents,
                config=config,
            )

            if not response.function_calls:
                final_text = self._apply_ot_safety_guardrail(response.text or "")
                return final_text, tools_used, missing_flags

            contents.append(response.candidates[0].content)

            tool_parts: List[types.Part] = []
            for fc in response.function_calls:
                fn_name = fc.name
                fn_args = dict(fc.args or {})
                tools_used.append(fn_name)
                try:
                    result = await self._dispatch_tool(fn_name, fn_args)
                    if isinstance(result, dict) and result.get("missing"):
                        missing_flags.extend(result["missing"])
                    payload = {"result": result}
                except Exception as exc:
                    logger.error("agent_tool_execution_error", tool=fn_name, error=str(exc))
                    payload = {"error": str(exc)}

                tool_parts.append(types.Part.from_function_response(name=fn_name, response=payload))

            contents.append(types.Content(role="tool", parts=tool_parts))

        return (
            "Limite de consultas atingido para esta análise. Informe o código de alarme ou janela específica.",
            tools_used,
            missing_flags,
        )

    async def ask(self, line_id: str, user_role: str, message: str, session_id: str | None) -> dict:
        """Copiloto conversacional com memória curta de sessão no Redis."""
        sid = session_id or uuid.uuid4().hex
        redis_key = f"agent:chat:{line_id}:{sid}"
        raw_hist = await self.redis.get(redis_key)

        history_contents: List[types.Content] = []
        stored_turns: List[dict] = json.loads(raw_hist) if raw_hist else []
        for turn in stored_turns[-6:]:  # mantém últimas 6 trocas para baixa latência
            history_contents.append(
                types.Content(role=turn["role"], parts=[types.Part.from_text(text=turn["text"])])
            )

        prompt = f"[Contexto: Linha={line_id} | Perfil={user_role}]\n{message}"
        answer, tools_used, missing = await self._run_agent_loop(prompt, history_contents)

        stored_turns.extend([{"role": "user", "text": prompt}, {"role": "model", "text": answer}])
        await self.redis.set(redis_key, json.dumps(stored_turns[-12:]), ex=3600)

        return {
            "session_id": sid,
            "line_id": line_id,
            "answer_markdown": answer,
            "tools_consulted": list(dict.fromkeys(tools_used)),
            "missing_data_flags": list(dict.fromkeys(missing)),
        }

    async def diagnose_alarm(self, line_id: str, alarm_code: int, description: str | None) -> dict:
        """Função 1: Diagnóstico guiado automático quando um alarme dispara."""
        prompt = (
            f"A célula {line_id} registrou o alarme alarme_ativo_cod={alarm_code} "
            f"(descrição CLP: '{description or 'não informada'}'). "
            "Consulte o snapshot em tempo real e a janela de telemetria dos últimos 90 segundos antes da falha. "
            "Entregue: (1) Causas raízes mais prováveis em ordem de probabilidade, "
            "(2) Passos objetivos e seguros de verificação física para o técnico, "
            "(3) Quais dados faltam no catálogo ou sensores caso o diagnóstico não feche 100%."
        )
        answer, tools_used, missing = await self._run_agent_loop(prompt)
        return {
            "line_id": line_id,
            "alarm_code": alarm_code,
            "diagnosis_markdown": answer,
            "tools_consulted": list(dict.fromkeys(tools_used)),
            "missing_data_flags": list(dict.fromkeys(missing)),
        }

    async def classify_downtime_one_click(self, line_id: str, downtime_id: int) -> OneClickStopClassification:
        """Função 3: Classificação estruturada em JSON para botão de 1 clique do operador."""
        ctx = await self.tools_impl.get_downtime_classification_context(line_id=line_id, downtime_id=downtime_id)
        if not ctx.get("found"):
            return OneClickStopClassification(
                downtime_id=downtime_id,
                suggested_reason_code_id=None,
                suggested_reason_label="Dados da parada não encontrados",
                confidence="BAIXA",
                evidence_summary="Evento de parada não localizado no banco para esta linha.",
                missing_variables=ctx.get("missing", []),
            )

        prompt = (
            "Analise o JSON abaixo contendo o evento de parada, os sensores dos 60s anteriores e a lista "
            "oficial de reason_codes_disponiveis. Escolha o reason_code_id mais provável para o operador confirmar com 1 clique.\n\n"
            f"{json.dumps(ctx, ensure_ascii=False)}"
        )

        response = await self.client.aio.models.generate_content(
            model=settings.GEMINI_MODEL,
            contents=prompt,
            config=types.GenerateContentConfig(
                system_instruction=NEXPULSE_SYSTEM_PROMPT,
                response_mime_type="application/json",
                response_schema=OneClickStopClassification,
                thinking_config=types.ThinkingConfig(thinking_level="low"),
            ),
        )
        return response.parsed

    async def run_predictive_check(self, line_id: str, hours: int = 4) -> PredictiveHealthReport:
        """Função 4: Auditoria preditiva estruturada de deriva de ciclo e microparadas."""
        health_ctx = await self.tools_impl.get_predictive_cycle_health(line_id=line_id, hours=hours)
        if not health_ctx.get("found"):
            return PredictiveHealthReport(
                line_id=line_id,
                risk_level="NORMAL",
                cycle_drift_detected=False,
                microstop_spike_detected=False,
                summary="Amostras insuficientes em produção para análise preditiva confiável.",
                recommended_inspections=[],
                missing_variables=health_ctx.get("missing", []),
            )

        prompt = (
            f"Avalie os indicadores preditivos das últimas {hours}h para a linha {line_id} e retorne o relatório estruturado:\n\n"
            f"{json.dumps(health_ctx, ensure_ascii=False)}"
        )
        response = await self.client.aio.models.generate_content(
            model=settings.GEMINI_MODEL,
            contents=prompt,
            config=types.GenerateContentConfig(
                system_instruction=NEXPULSE_SYSTEM_PROMPT,
                response_mime_type="application/json",
                response_schema=PredictiveHealthReport,
                thinking_config=types.ThinkingConfig(thinking_level="medium"),
            ),
        )
        return response.parsed
7. Rotas da API do Agente e Integração no main.py
app/api/agent_routes.py
Python
from fastapi import APIRouter, Depends, Query, Request
from sqlalchemy.ext.asyncio import AsyncSession

from app.agent.nexpulse_agent import NexPulseAgentService
from app.agent.schemas import (
    AgentChatRequest,
    AgentChatResponse,
    AlarmDiagnoseRequest,
    OneClickStopClassification,
    PredictiveHealthReport,
)
from app.db.session import get_db

router = APIRouter(prefix="/api/v1/agent", tags=["NexPulse AI Agent"])


def _get_agent(request: Request, db: AsyncSession = Depends(get_db)) -> NexPulseAgentService:
    return NexPulseAgentService(db=db, redis=request.app.state.redis)


@router.post("/ask", response_model=AgentChatResponse)
async def chat_with_agent(
    body: AgentChatRequest, agent: NexPulseAgentService = Depends(_get_agent)
) -> AgentChatResponse:
    res = await agent.ask(
        line_id=body.line_id,
        user_role=body.user_role,
        message=body.message,
        session_id=body.session_id,
    )
    return AgentChatResponse(**res)


@router.post("/alarms/diagnose")
async def diagnose_alarm(
    body: AlarmDiagnoseRequest, agent: NexPulseAgentService = Depends(_get_agent)
) -> dict:
    return await agent.diagnose_alarm(
        line_id=body.line_id,
        alarm_code=body.alarme_ativo_cod,
        description=body.alarm_description,
    )


@router.post("/lines/{line_id}/downtimes/{downtime_id}/suggest", response_model=OneClickStopClassification)
async def suggest_stop_classification(
    line_id: str, downtime_id: int, agent: NexPulseAgentService = Depends(_get_agent)
) -> OneClickStopClassification:
    return await agent.classify_downtime_one_click(line_id=line_id, downtime_id=downtime_id)


@router.get("/lines/{line_id}/predictive-check", response_model=PredictiveHealthReport)
async def predictive_check(
    line_id: str,
    hours: int = Query(4, ge=1, le=72),
    agent: NexPulseAgentService = Depends(_get_agent),
) -> PredictiveHealthReport:
    return await agent.run_predictive_check(line_id=line_id, hours=hours)
