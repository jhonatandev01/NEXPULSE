5. Ferramentas Read-Only Conectadas ao Redis & TimescaleDB
app/agent/tools.py
Cada ferramenta traduz os campos internos do backend (machine_state, boxes_shift, etc.) para as tags oficiais do NexPulse (linha_estado, caixas_turno, etc.), garantindo que o raciocínio do modelo bata 100% com o domínio da fábrica.
Python
import json
from datetime import datetime, timedelta, timezone
from typing import Any, Dict, List, Optional
from redis.asyncio import Redis
from sqlalchemy import and_, desc, func, select
from sqlalchemy.ext.asyncio import AsyncSession

from app.db.models import (
    AnomalyAlert, DowntimeEvent, DowntimeTypeEnum, MachineStateEnum,
    PalletRecord, ProductRecipe, ReasonCode, TelemetryPoint
)
from app.services.oee_engine import OEEAnalyticsEngine


class NexPulseReadOnlyTools:
    """
    Conjunto estrito de ferramentas READ-ONLY.
    Não expõe nenhum método de escrita no CLP, MQTT ou alteração de parâmetros físicos.
    """

    def __init__(self, db: AsyncSession, redis: Redis) -> None:
        self.db = db
        self.redis = redis

    async def get_realtime_cell_snapshot(self, line_id: str) -> Dict[str, Any]:
        """Consulta o estado em tempo real da célula no cache Redis usando as tags do NexPulse."""
        raw = await self.redis.get(f"line:state:{line_id}")
        if not raw:
            return {
                "found": False,
                "line_id": line_id,
                "missing": ["snapshot_redis_em_tempo_real (linha pode estar offline ou sem telemetria nos últimos 5 min)"],
            }

        snap = json.loads(raw.decode("utf-8") if isinstance(raw, bytes) else raw)
        recipe = (
            await self.db.execute(select(ProductRecipe).where(ProductRecipe.sku == snap.get("sku")))
        ).scalar_one_or_none()

        return {
            "found": True,
            "line_id": line_id,
            "timestamp": snap.get("timestamp"),
            "linha_estado": snap.get("machine_state"),
            "linha_estado_label": MachineStateEnum(snap["machine_state"]).name,
            "robo_status": snap.get("robot_status"),
            "esteira_entrada_ok": snap.get("conveyor_in_ok"),
            "esteira_saida_ok": snap.get("conveyor_out_ok"),
            "caixas_turno": snap.get("boxes_shift"),
            "paletes_concluidos": snap.get("completed_pallets"),
            "ciclo_atual_seg": snap.get("cycle_time_sec"),
            "ciclo_ewma_seg": snap.get("ewma_cycle_sec"),
            "ciclo_ideal_receita_seg": recipe.ideal_cycle_sec if recipe else None,
            "sku_ativo": snap.get("sku"),
            "camada_atual": snap.get("current_layer"),
            "camadas_total": snap.get("total_layers"),
            "caixas_na_camada": snap.get("boxes_in_layer"),
            "caixas_por_camada": snap.get("boxes_per_layer"),
            "alarme_ativo_cod": snap.get("alarm_code"),
            "alarme_descricao": snap.get("alarm_description"),
            "em_parada_aberta": snap.get("in_downtime"),
        }

    async def get_telemetry_context_window(
        self, line_id: str, seconds_before: int = 90, reference_iso: Optional[str] = None
    ) -> Dict[str, Any]:
        """Retorna a sequência temporal dos sensores antes de um instante de referência (ou agora)."""
        ref_dt = (
            datetime.fromisoformat(reference_iso.replace("Z", "+00:00"))
            if reference_iso
            else datetime.now(timezone.utc)
        )
        start_dt = ref_dt - timedelta(seconds=min(max(seconds_before, 10), 600))

        stmt = (
            select(TelemetryPoint)
            .where(
                and_(
                    TelemetryPoint.line_id == line_id,
                    TelemetryPoint.time >= start_dt,
                    TelemetryPoint.time <= ref_dt,
                )
            )
            .order_by(TelemetryPoint.time.asc())
            .limit(120)
        )
        rows = (await self.db.execute(stmt)).scalars().all()
        if not rows:
            return {
                "found": False,
                "window_start": start_dt.isoformat(),
                "window_end": ref_dt.isoformat(),
                "missing": ["telemetry_points (histórico de sensores no TimescaleDB para esta janela)"],
            }

        return {
            "found": True,
            "samples_count": len(rows),
            "timeline": [
                {
                    "time": r.time.isoformat(),
                    "linha_estado": r.machine_state,
                    "robo_status": r.robot_status,
                    "esteira_entrada_ok": r.conveyor_in_ok,
                    "esteira_saida_ok": r.conveyor_out_ok,
                    "ciclo_atual_seg": r.cycle_time_sec,
                    "camada_atual": r.current_layer,
                    "caixas_na_camada": r.boxes_in_layer,
                    "alarme_ativo_cod": r.alarm_code,
                }
                for r in rows
            ],
        }

    async def get_shift_oee_and_pareto(self, line_id: str, hours: int = 8) -> Dict[str, Any]:
        """Calcula OEE (Disponibilidade, Performance, Qualidade), Pareto de paradas e anomalias de paletes."""
        end = datetime.now(timezone.utc)
        start = end - timedelta(hours=min(max(hours, 1), 168))

        oee = await OEEAnalyticsEngine.calculate_oee(self.db, line_id, start, end)
        pareto = await OEEAnalyticsEngine.get_pareto_downtimes(self.db, line_id, start, end, limit=5)

        recent_downtimes = (
            await self.db.execute(
                select(DowntimeEvent)
                .where(and_(DowntimeEvent.line_id == line_id, DowntimeEvent.started_at >= start))
                .order_by(desc(DowntimeEvent.started_at))
                .limit(15)
            )
        ).scalars().all()

        pallet_stats = (
            await self.db.execute(
                select(PalletRecord.status, func.count(PalletRecord.id))
                .where(and_(PalletRecord.line_id == line_id, PalletRecord.started_at >= start))
                .group_by(PalletRecord.status)
            )
        ).all()

        return {
            "oee_metrics": oee.model_dump(mode="json"),
            "pareto_paradas": pareto,
            "resumo_paletes_por_status": {str(st.value): cnt for st, cnt in pallet_stats},
            "eventos_paradas_alarmes_recentes": [
                {
                    "id": d.id,
                    "tipo": d.downtime_type.value,
                    "linha_estado": d.machine_state,
                    "alarme_ativo_cod": d.alarm_code,
                    "alarme_descricao": d.alarm_description,
                    "inicio": d.started_at.isoformat(),
                    "duracao_seg": d.duration_sec,
                    "justificada": d.reason_code_id is not None,
                }
                for d in recent_downtimes
            ],
        }

    async def get_downtime_classification_context(self, line_id: str, downtime_id: int) -> Dict[str, Any]:
        """Carrega dados da parada, catálogo oficial de ReasonCodes e sensores pré-parada."""
        ev = await self.db.get(DowntimeEvent, downtime_id)
        if not ev or ev.line_id != line_id:
            return {"found": False, "missing": [f"DowntimeEvent id={downtime_id} para linha {line_id}"]}

        reasons = (await self.db.execute(select(ReasonCode))).scalars().all()
        pre_window = await self.get_telemetry_context_window(
            line_id=line_id, seconds_before=60, reference_iso=ev.started_at.isoformat()
        )

        return {
            "found": True,
            "downtime_event": {
                "id": ev.id,
                "linha_estado": ev.machine_state,
                "tipo": ev.downtime_type.value,
                "alarme_ativo_cod": ev.alarm_code,
                "alarme_descricao": ev.alarm_description,
                "started_at": ev.started_at.isoformat(),
                "duration_sec": ev.duration_sec,
            },
            "reason_codes_disponiveis": [
                {
                    "id": r.id,
                    "code": r.code,
                    "category": r.category,
                    "description": r.description,
                    "is_planned_stop": r.is_planned_stop,
                }
                for r in reasons
            ],
            "telemetria_60s_antes": pre_window,
        }

    async def get_predictive_cycle_health(self, line_id: str, hours: int = 4) -> Dict[str, Any]:
        """Analisa deriva de tempo de ciclo (ciclo_atual_seg / EWMA) e frequência de microparadas."""
        end = datetime.now(timezone.utc)
        start = end - timedelta(hours=min(max(hours, 1), 72))

        rows = (
            await self.db.execute(
                select(TelemetryPoint)
                .where(
                    and_(
                        TelemetryPoint.line_id == line_id,
                        TelemetryPoint.time >= start,
                        TelemetryPoint.machine_state == MachineStateEnum.RUNNING.value,
                        TelemetryPoint.cycle_time_sec > 0,
                    )
                )
                .order_by(TelemetryPoint.time.asc())
            )
        ).scalars().all()

        microstops_count = (
            await self.db.execute(
                select(func.count(DowntimeEvent.id)).where(
                    and_(
                        DowntimeEvent.line_id == line_id,
                        DowntimeEvent.started_at >= start,
                        DowntimeEvent.downtime_type == DowntimeTypeEnum.MICROSTOP,
                    )
                )
            )
        ).scalar_one()

        recent_alerts = (
            await self.db.execute(
                select(AnomalyAlert)
                .where(and_(AnomalyAlert.line_id == line_id, AnomalyAlert.created_at >= start))
                .order_by(desc(AnomalyAlert.created_at))
                .limit(10)
            )
        ).scalars().all()

        if len(rows) < 10:
            return {
                "found": False,
                "microstops_na_janela": microstops_count,
                "missing": ["amostras_suficientes_de_ciclo_em_producao (mínimo 10 pontos com linha_estado=1)"],
            }

        cycles = [r.cycle_time_sec for r in rows]
        mid = len(cycles) // 2
        avg_first_half = sum(cycles[:mid]) / mid
        avg_second_half = sum(cycles[mid:]) / (len(cycles) - mid)
        drift_pct = ((avg_second_half - avg_first_half) / avg_first_half) * 100.0 if avg_first_half > 0 else 0.0

        last_sku = rows[-1].sku
        recipe = (await self.db.execute(select(ProductRecipe).where(ProductRecipe.sku == last_sku))).scalar_one_or_none()

        return {
            "found": True,
            "samples": len(cycles),
            "sku_referencia": last_sku,
            "ciclo_ideal_receita_seg": recipe.ideal_cycle_sec if recipe else None,
            "ciclo_medio_primeira_metade_seg": round(avg_first_half, 3),
            "ciclo_medio_segunda_metade_seg": round(avg_second_half, 3),
            "deriva_percentual": round(drift_pct, 2),
            "ultimo_ewma_seg": round(rows[-1].ewma_cycle_sec, 3),
            "microparadas_na_janela": microstops_count,
            "alertas_anomalia_recentes": [
                {"tipo": a.alert_type, "severidade": a.severity, "mensagem": a.message, "em": a.created_at.isoformat()}
                for a in recent_alerts
            ],
        }


