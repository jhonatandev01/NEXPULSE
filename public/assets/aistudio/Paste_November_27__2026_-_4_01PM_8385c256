import React, { useCallback, useEffect, useState } from "react";
import { Bot, AlertTriangle, Wifi, WifiOff } from "lucide-react";
import { useLineWebSocket } from "./hooks/useLineWebSocket";
import { PalletVisualizer } from "./components/PalletVisualizer";
import { DowntimeOneClickCard } from "./components/DowntimeOneClickCard";
import { NexPulseCopilotDrawer } from "./components/NexPulseCopilotDrawer";
import { DowntimeItem, OEEMetrics } from "./types/nexpulse";

const LINE_ID = "PAL-01";
const API_URL = "http://localhost:8000";

export default function App() {
  const { snapshot, wsStatus } = useLineWebSocket(LINE_ID, "ws://localhost:8000");
  const [oee, setOee] = useState<OEEMetrics | null>(null);
  const [downtimes, setDowntimes] = useState<DowntimeItem[]>([]);
  const [copilotOpen, setCopilotOpen] = useState(false);

  const loadAnalytics = useCallback(async () => {
    try {
      const [oeeRes, dtRes] = await Promise.all([
        fetch(`${API_URL}/api/v1/lines/${LINE_ID}/oee?hours=8`),
        fetch(`${API_URL}/api/v1/lines/${LINE_ID}/downtimes?only_unjustified=true`),
      ]);
      if (oeeRes.ok) setOee(await oeeRes.json());
      if (dtRes.ok) setDowntimes(await dtRes.json());
    } catch (err) {
      console.error("Erro ao atualizar indicadores:", err);
    }
  }, []);

  useEffect(() => {
    loadAnalytics();
    const id = window.setInterval(loadAnalytics, 10000);
    return () => window.clearInterval(id);
  }, [loadAnalytics]);

  // Abre o Copiloto automaticamente se houver alarme crítico ativo
  useEffect(() => {
    if (snapshot && snapshot.alarm_code > 0) setCopilotOpen(true);
  }, [snapshot?.alarm_code]);

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 p-4 md:p-6">
      {/* Cabeçalho */}
      <header className="flex flex-wrap items-center justify-between gap-4 pb-5 mb-6 border-b border-slate-800">
        <div>
          <h1 className="text-xl font-bold tracking-tight">NexPulse Portal • Monitoramento de Paletização</h1>
          <p className="text-xs text-slate-400 mt-0.5">Célula {LINE_ID} • Tempo Real via OPC UA / MQTT / WebSocket</p>
        </div>

        <div className="flex items-center gap-3">
          <span className={`flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-full border ${
            wsStatus === "ONLINE"
              ? "border-emerald-700 bg-emerald-950/40 text-emerald-300"
              : "border-red-700 bg-red-950/40 text-red-300"
          }`}>
            {wsStatus === "ONLINE" ? <Wifi size={14} /> : <WifiOff size={14} />}
            {wsStatus}
          </span>

          <button
            onClick={() => setCopilotOpen(true)}
            className="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold px-4 py-2 rounded-lg shadow"
          >
            <Bot size={16} /> Copiloto IA
          </button>
        </div>
      </header>

      {/* Banner de Alarme Ativo */}
      {snapshot && snapshot.alarm_code > 0 && (
        <div className="mb-6 bg-red-950/70 border border-red-600 rounded-xl p-4 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <AlertTriangle className="text-red-400 shrink-0" size={24} />
            <div>
              <p className="text-sm font-bold text-red-100">
                ALARME ATIVO #{snapshot.alarm_code}: {snapshot.alarm_description || "Falha na célula"}
              </p>
              <p className="text-xs text-red-300">O Agente NexPulse iniciou o diagnóstico guiado no painel lateral.</p>
            </div>
          </div>
          <button
            onClick={() => setCopilotOpen(true)}
            className="text-xs bg-red-600 hover:bg-red-500 text-white font-semibold px-3 py-1.5 rounded-lg"
          >
            Ver Diagnóstico
          </button>
        </div>
      )}

      {/* KPIs do Turno */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <p className="text-xs text-slate-400">Caixas no Turno</p>
          <p className="text-2xl font-bold mt-1">{snapshot?.boxes_shift ?? "--"}</p>
        </div>
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <p className="text-xs text-slate-400">Paletes Concluídos</p>
          <p className="text-2xl font-bold mt-1">{snapshot?.completed_pallets ?? "--"}</p>
        </div>
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <p className="text-xs text-slate-400">OEE Turno (8h)</p>
          <p className="text-2xl font-bold text-sky-400 mt-1">{oee ? `${oee.oee}%` : "--"}</p>
          {oee && (
            <p className="text-[11px] text-slate-500 mt-1">
              D:{oee.availability}% • P:{oee.performance}% • Q:{oee.quality}%
            </p>
          )}
        </div>
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <p className="text-xs text-slate-400">Tempo Parado (8h)</p>
          <p className="text-2xl font-bold text-amber-400 mt-1">{oee ? `${oee.downtime_sec}s` : "--"}</p>
        </div>
      </div>

      {/* Sinótico + Formação do Palete */}
      {snapshot ? (
        <div className="mb-6">
          <PalletVisualizer data={snapshot} />
        </div>
      ) : (
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-8 text-center text-slate-400 mb-6">
          Aguardando telemetria em tempo real da célula {LINE_ID}...
        </div>
      )}

      {/* Paradas com Classificação 1-Clique */}
      <DowntimeOneClickCard
        lineId={LINE_ID}
        downtimes={downtimes}
        apiBaseUrl={API_URL}
        onJustified={loadAnalytics}
      />

      {/* Drawer do Copiloto NexPulse */}
      <NexPulseCopilotDrawer
        lineId={LINE_ID}
        apiBaseUrl={API_URL}
        snapshot={snapshot}
        isOpen={copilotOpen}
        onClose={() => setCopilotOpen(false)}
      />
    </div>
  );
}