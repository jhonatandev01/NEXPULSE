import { useEffect, useRef, useState } from "react";
import { LineSnapshot } from "../types/nexpulse";

export function useLineWebSocket(lineId: string, wsBaseUrl = "ws://localhost:8000") {
  const [snapshot, setSnapshot] = useState<LineSnapshot | null>(null);
  const [wsStatus, setWsStatus] = useState<"CONNECTING" | "ONLINE" | "OFFLINE">("CONNECTING");
  const retryRef = useRef(1000);

  useEffect(() => {
    let ws: WebSocket | null = null;
    let timer: number | undefined;
    let unmounted = false;

    const connect = () => {
      if (unmounted) return;
      setWsStatus("CONNECTING");
      ws = new WebSocket(`${wsBaseUrl}/ws/lines/${lineId}`);

      ws.onopen = () => {
        setWsStatus("ONLINE");
        retryRef.current = 1000;
      };

      ws.onmessage = (event) => {
        try {
          const data: LineSnapshot = JSON.parse(event.data);
          setSnapshot(data);
        } catch (err) {
          console.error("Erro ao parsear frame WebSocket:", err);
        }
      };

      ws.onclose = () => {
        if (unmounted) return;
        setWsStatus("OFFLINE");
        timer = window.setTimeout(() => {
          retryRef.current = Math.min(retryRef.current * 2, 15000);
          connect();
        }, retryRef.current);
      };

      ws.onerror = () => ws?.close();
    };

    connect();
    return () => {
      unmounted = true;
      window.clearTimeout(timer);
      ws?.close();
    };
  }, [lineId, wsBaseUrl]);

  return { snapshot, wsStatus };
}
