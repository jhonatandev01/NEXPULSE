import React, { useEffect, useState } from "react";
import { Bot, Send, ShieldAlert, X, Activity } from "lucide-react";
import { LineSnapshot, PredictiveReport } from "../types/nexpulse";

interface Props {
  lineId: string;
  apiBaseUrl: string;
  snapshot: LineSnapshot | null;
  isOpen: boolean;
  onClose: () => void;
}

interface ChatMsg {
  role: "user" | "agent" | "alarm";
  text: string;
}

export const NexPulseCopilotDrawer: React.FC<Props> = ({ lineId, apiBaseUrl, snapshot, isOpen, onClose }) => {
  const [role, setRole] = useState<"operador" | "manutencao" | "supervisor">("manutencao");
  const [input, setInput] = useState("");
  const [sessionId, setSessionId] = useState<string | null>(null);
  const [messages, setMessages] = useState<ChatMsg[]>([]);
  const [loading, setLoading] = useState(false);
  const [lastDiagnosedAlarm, setLastDiagnosedAlarm] = useState<number>(0);
  const [predictive, setPredictive] = useState<PredictiveReport | null>(null);

  // Gatilho automático via WebSocket quando um alarme novo dispara (linha_estado == 5)
  useEffect(() => {
    if (!snapshot) return;
    if (snapshot.alarm_code > 0 && snapshot.alarm_code !== lastDiagnosedAlarm) {
      setLastDiagnosedAlarm(snapshot.alarm_code);
      (async () => {
        try {
          const res = await fetch(`${apiBaseUrl}/api/v1/agent/alarms/diagnose`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              line_id: lineId,
              alarme_ativo_cod: snapshot.alarm_code,
              alarm_description: snapshot.alarm_description,
            }),
          });
          const data = await res.json();
          setMessages((prev) => [
            ...prev,
            {
              role: "alarm",
              text: `🚨 ALARME ${snapshot.alarm_code} DETECTADO AUTOMATICAMENTE:\n\n${data.diagnosis_markdown}`,
            },
          ]);
        } catch (err) {
          console.error("Falha no diagnóstico automático:", err);
        }
      })();
    } else if (snapshot.alarm_code === 0 && lastDiagnosedAlarm !== 0) {
      setLastDiagnosedAlarm(0);
    }
  }, [snapshot?.alarm_code]);

  const sendMessage = async (textToSend?: string) => {
    const query = (textToSend ?? input).trim();
    if (!query || loading) return;
    if (!textToSend) setInput("");

    setMessages((prev) => [...prev, { role: "user", text: query }]);
    setLoading(true);
    try {
      const res = await fetch(`${apiBaseUrl}/api/v1/agent/ask`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          line_id: lineId,
          session_id: sessionId,
          user_role: role,
          message: query,
        }),
      });
      const data = await res.json();
      setSessionId(data.session_id);
      setMessages((prev) => [...prev, { role: "agent", text: data.answer_markdown }]);
    } catch {
      setMessages((prev) => [
        ...prev,
        { role: "agent", text: "Erro de comunicação com o backend do Agente NexPulse." },
      ]);
    } finally {
      setLoading(false);
    }
  };

  const checkPredictive = async () => {
    const res = await fetch(`${apiBaseUrl}/api/v1/agent/lines/${lineId}/predictive-check?hours=4`);
    setPredictive(await res.json());
  };

  if (!isOpen) return null;

  return (
    <div className="fixed inset-y-0 right-0 w-full max-w-md bg-slate-950 border-l border-slate-800 shadow-2xl flex flex-col z-50">
      <div className="p-4 border-b border-slate-800 flex items-center justify-between bg-slate-900">
        <div className="flex items-center gap-2">
          <Bot className="text-indigo-400" size={20} />
          <div>
            <h2 className="text-sm font-bold text-white">Copiloto Industrial NexPulse</h2>
            <p className="text-[11px] text-slate-400">Somente leitura • CLP é fonte única da verdade</p>
          </div>
        </div>
        <button onClick={onClose} className="text-slate-400 hover:text-white"><X size={20} /></button>
      </div>

      {/* Perfil & Ações Rápidas */}
      <div className="p-3 border-b border-slate-800 bg-slate-900/50 space-y-2">
        <div className="flex gap-1.5">
          {(["operador", "manutencao", "supervisor"] as const).map((r) => (
            <button
              key={r}
              onClick={() => setRole(r)}
              className={`flex-1 py-1 text-xs rounded font-medium capitalize ${
                role === r ? "bg-indigo-600 text-white" : "bg-slate-800 text-slate-400"
              }`}
            >
              {r}
            </button>
          ))}
        </div>
        <div className="flex gap-1.5 flex-wrap">
          <button
            onClick={() => sendMessage("Faça uma análise do OEE e dos gargalos deste turno.")}
            className="text-[11px] bg-slate-800 hover:bg-slate-700 text-slate-200 px-2.5 py-1 rounded"
          >
            Analisar OEE do Turno
          </button>
          <button
            onClick={checkPredictive}
            className="text-[11px] bg-slate-800 hover:bg-slate-700 text-amber-300 px-2.5 py-1 rounded flex items-center gap-1"
          >
            <Activity size={12} /> Saúde Preditiva
          </button>
        </div>

        {predictive && (
          <div className={`p-2.5 rounded-lg border text-xs ${
            predictive.risk_level === "CRITICO"
              ? "bg-red-950/40 border-red-700 text-red-200"
              : predictive.risk_level === "ATENCAO"
              ? "bg-amber-950/40 border-amber-700 text-amber-200"
              : "bg-emerald-950/30 border-emerald-800 text-emerald-200"
          }`}>
            <strong>Risco Preditivo: {predictive.risk_level}</strong>
            <p className="mt-1">{predictive.summary}</p>
          </div>
        )}
      </div>

      {/* Mensagens */}
      <div className="flex-1 overflow-y-auto p-4 space-y-3">
        {messages.length === 0 && (
          <p className="text-xs text-slate-500 text-center mt-8">
            Pergunte sobre falhas, variações de OEE, ciclo do robô ou aguarde um diagnóstico automático de alarme.
          </p>
        )}
        {messages.map((m, i) => (
          <div
            key={i}
            className={`p-3 rounded-xl text-xs whitespace-pre-wrap leading-relaxed ${
              m.role === "user"
                ? "bg-indigo-600 text-white ml-8"
                : m.role === "alarm"
                ? "bg-red-950/60 border border-red-700 text-red-100"
                : "bg-slate-900 border border-slate-800 text-slate-200 mr-4"
            }`}
          >
            {m.role === "alarm" && <ShieldAlert className="inline mr-1.5 text-red-400" size={14} />}
            {m.text}
          </div>
        ))}
        {loading && <p className="text-xs text-indigo-400 animate-pulse">Consultando TimescaleDB e Redis...</p>}
      </div>

      {/* Input */}
      <div className="p-3 border-t border-slate-800 flex gap-2 bg-slate-900">
        <input
          value={input}
          onChange={(e) => setInput(e.target.value)}
          onKeyDown={(e) => e.key === "Enter" && sendMessage()}
          placeholder="Pergunte ao Copiloto NexPulse..."
          className="flex-1 bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-indigo-500"
        />
        <button
          onClick={() => sendMessage()}
          className="bg-indigo-600 hover:bg-indigo-500 text-white px-3 rounded-lg flex items-center"
        >
          <Send size={15} />
        </button>
      </div>
    </div>
  );
