              ? "border-sky-600/60 bg-sky-950/30"
              : "border-amber-600/60 bg-amber-950/30"
          }`}>
            <Cpu className="mx-auto mb-1 text-slate-300" size={20} />
            <p className="text-xs text-slate-400">Robô Paletizador</p>
            <p className="font-bold text-sm mt-0.5">{data.machine_state_label}</p>
          </div>

          <ArrowRight className="text-slate-600 shrink-0" size={20} />

          <div className={`flex-1 p-3 rounded-lg border text-center ${
            data.conveyor_out_ok ? "border-emerald-700/50 bg-emerald-950/20" : "border-amber-500 bg-amber-950/40"
          }`}>
            <p className="text-xs text-slate-400">Esteira Saída</p>
            <p className="font-bold text-sm mt-1">
              {data.conveyor_out_ok ? "LIVRE" : "PALETE CHEIO"}
            </p>
          </div>
        </div>

        <div className="mt-4 pt-4 border-t border-slate-800 flex justify-between text-xs text-slate-400">
          <span>SKU Ativo: <strong className="text-slate-100">{data.sku}</strong></span>
          <span>Ciclo Atual: <strong className="text-sky-400">{data.cycle_time_sec.toFixed(2)}s</strong> (EWMA {data.ewma_cycle_sec.toFixed(2)}s)</span>
        </div>
      </div>

      {/* Formação Visual do Palete (Camadas + Grade 2D) */}
      <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
        <div className="flex justify-between items-center mb-4">
          <h3 className="text-xs font-semibold uppercase tracking-wider text-slate-400 flex items-center gap-2">
            <Layers size={15} /> Formação do Palete em Tempo Real
          </h3>
          <span className="text-xs font-mono bg-slate-800 px-2.5 py-1 rounded text-slate-200">
            {data.active_pallet_boxes} / {data.target_pallet_boxes || "?"} cx
          </span>
        </div>

        <div className="grid grid-cols-3 gap-4 items-center">
          {/* Pilha vertical de camadas */}
          <div className="col-span-1 flex flex-col gap-1.5">
            {layers.map((layerNum) => {
              const isDone = layerNum < data.current_layer;
              const isActive = layerNum === data.current_layer;
              return (
                <div
                  key={layerNum}
                  className={`h-7 rounded flex items-center justify-center text-xs font-semibold border ${
                    isDone
                      ? "bg-emerald-600/30 border-emerald-500/60 text-emerald-200"
                      : isActive
                      ? "bg-sky-600/40 border-sky-400 text-white"
                      : "bg-slate-800/60 border-slate-700 text-slate-500"
                  }`}
                >
                  Camada {layerNum}
                </div>
              );
            })}
          </div>

          {/* Grade 2D da camada atual */}
          <div className="col-span-2 bg-slate-950 border border-slate-800 rounded-lg p-3">
            <p className="text-xs text-slate-400 mb-2">
              Camada Atual ({data.current_layer}/{totalLayers}) —{" "}
              <strong className="text-slate-100">{data.boxes_in_layer}/{totalBoxesLayer} caixas</strong>
            </p>
            <div className="grid grid-cols-4 gap-2">
              {slots.map((filled, idx) => (
                <div
                  key={idx}
                  className={`h-10 rounded flex items-center justify-center border transition-all ${
                    filled
                      ? "bg-amber-600/30 border-amber-500 text-amber-200"
                      : "bg-slate-900 border-slate-800 border-dashed text-slate-700"
                  }`}
                >
                  <Box size={16} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};
