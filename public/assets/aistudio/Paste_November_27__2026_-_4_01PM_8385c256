import React, { useState } from "react";
import { Sparkles, CheckCircle2, Clock } from "lucide-react";
import { DowntimeItem, OneClickSuggestion } from "../types/nexpulse";

interface Props {
  lineId: string;
  downtimes: DowntimeItem[];
  apiBaseUrl: string;
  onJustified: () => void;
}

export const DowntimeOneClickCard: React.FC<Props> = ({ lineId, downtimes, apiBaseUrl, onJustified }) => {
  const [suggestions, setSuggestions] = useState<Record<number, OneClickSuggestion>>({});
  const [loadingId, setLoadingId] = useState<number | null>(null);

  const askAISuggestion = async (downtimeId: number) => {
    setLoadingId(downtimeId);
    try {
      const res = await fetch(`${apiBaseUrl}/api/v1/agent/lines/${lineId}/downtimes/${downtimeId}/suggest`, {
        method: "POST",
      });
      const data: OneClickSuggestion = await res.json();
      setSuggestions((prev) => ({ ...prev, [downtimeId]: data }));
    } finally {
      setLoadingId(null);
    }
  };

  const confirmOneClick = async (downtimeId: number, reasonCodeId: number, evidence: string) => {
    await fetch(`${apiBaseUrl}/api/v1/downtimes/${downtimeId}/justify`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        reason_code_id: reasonCodeId,
        justified_by: "Operador (1-Clique IA)",
        notes: evidence,
      }),
    });
    onJustified();
  };

  return (
    <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
      <div className="flex justify-between items-center mb-4">
        <h3 className="text-xs font-semibold uppercase tracking-wider text-slate-400 flex items-center gap-2">
          <Clock size={15} /> Paradas Aguardando Justificativa ({downtimes.length})
        </h3>
      </div>

      {downtimes.length === 0 ? (
        <p className="text-sm text-slate-500 py-4 text-center">Nenhuma parada pendente neste turno.</p>
      ) : (
        <div className="space-y-3">
          {downtimes.slice(0, 4).map((dt) => {
            const sug = suggestions[dt.id];
            return (
              <div key={dt.id} className="bg-slate-950 border border-slate-800 rounded-lg p-3">
                <div className="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <span className="text-xs font-bold px-2 py-0.5 rounded bg-red-950 text-red-300 border border-red-800/50 mr-2">
                      {dt.type}
                    </span>
                    <span className="text-sm text-slate-200 font-medium">
                      {dt.alarm_description || `Estado ${dt.machine_state} / Alarme ${dt.alarm_code}`}
                    </span>
                    <p className="text-xs text-slate-500 mt-0.5">
                      Início: {new Date(dt.started_at).toLocaleTimeString()} • Duração:{" "}
                      {dt.duration_sec ? `${dt.duration_sec}s` : "Em andamento"}
                    </p>
                  </div>

                  {!sug && (
                    <button
                      onClick={() => askAISuggestion(dt.id)}
                      disabled={loadingId === dt.id}
                      className="flex items-center gap-1.5 text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white px-3 py-1.5 rounded-lg transition"
                    >
                      <Sparkles size={14} />
                      {loadingId === dt.id ? "Analisando sensores..." : "Classificar com IA"}
                    </button>
                  )}
                </div>

                {sug && (
                  <div className="mt-3 pt-3 border-t border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div className="text-xs">
                      <span className="text-indigo-400 font-bold">Sugestão ({sug.confidence}): </span>
                      <span className="text-slate-100 font-semibold">{sug.suggested_reason_label}</span>
                      <p className="text-slate-400 mt-0.5">{sug.evidence_summary}</p>
                    </div>
                    {sug.suggested_reason_code_id !== null ? (
                      <button
                        onClick={() => confirmOneClick(dt.id, sug.suggested_reason_code_id!, sug.evidence_summary)}
                        className="shrink-0 flex items-center gap-1.5 text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-2 rounded-lg"
                      >
                        <CheckCircle2 size={15} /> Confirmar em 1 Clique
                      </button>
                    ) : (
                      <span className="text-xs text-amber-400">Cadastre ReasonCodes no banco para confirmar</span>
                    )}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
};
