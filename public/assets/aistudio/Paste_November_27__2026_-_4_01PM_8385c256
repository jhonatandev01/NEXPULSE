from typing import Dict, Any
import httpx
import structlog
from app.agent.schemas import OneClickStopClassification, PredictiveHealthReport

logger = structlog.get_logger()


class OfflineAgentFallback:
    """
    Garante operação do NexPulse Agent sem internet:
    1) Tenta LLM Local (Ollama na intranet da fábrica).
    2) Se Ollama não estiver disponível, aplica regras determinísticas industriais.
    """

    @staticmethod
    async def try_local_ollama(prompt: str, ollama_url: str = "http://localhost:11434") -> str | None:
        try:
            async with httpx.AsyncClient(timeout=15.0) as client:
                resp = await client.post(
                    f"{ollama_url}/api/generate",
                    json={"model": "qwen2.5:7b", "prompt": prompt, "stream": False},
                )
                if resp.status_code == 200:
                    return resp.json().get("response")
        except Exception as exc:
            logger.debug("local_ollama_unavailable", reason=str(exc))
        return None

    @staticmethod
    def deterministic_stop_classification(downtime_id: int, ctx: Dict[str, Any]) -> OneClickStopClassification:
        """Regra local determinística baseada nos sensores pré-parada."""
        ev = ctx.get("downtime_event", {})
        reasons = ctx.get("reason_codes_disponiveis", [])
        timeline = ctx.get("telemetria_60s_antes", {}).get("timeline", [])
        last_sample = timeline[-1] if timeline else {}

        state = ev.get("linha_estado")
        in_ok = last_sample.get("esteira_entrada_ok", True)
        out_ok = last_sample.get("esteira_saida_ok", True)

        keyword = None
        evidence = "Classificação offline por regras locais de sensores."
        confidence = "MEDIA"

        if state == 2 or not in_ok:
            keyword = "material"
            evidence = "Estado 2 ou sensor esteira_entrada_ok=False antes da parada (falta de caixas/insumo)."
            confidence = "ALTA"
        elif state == 3 or not out_ok:
            keyword = "retirada"
            evidence = "Estado 3 ou esteira_saida_ok=False (acúmulo na saída / aguardando empilhadeira)."
            confidence = "ALTA"
        elif state == 5:
            keyword = "falha"
            evidence = f"Falha física no equipamento (alarme_ativo_cod={ev.get('alarme_ativo_cod')})."
            confidence = "ALTA"

        matched = next((r for r in reasons if keyword and keyword in r["description"].lower()), None)
        if not matched and reasons:
            matched = reasons[0]
            confidence = "BAIXA"

        return OneClickStopClassification(
            downtime_id=downtime_id,
            suggested_reason_code_id=matched["id"] if matched else None,
            suggested_reason_label=matched["description"] if matched else "Motivo não mapeado offline",
            confidence=confidence,
            evidence_summary=f"[MODO OFFLINE] {evidence}",
            missing_variables=[] if timeline else ["telemetry_points_60s_antes"],
        )

    @staticmethod
    def deterministic_predictive_check(line_id: str, health_ctx: Dict[str, Any]) -> PredictiveHealthReport:
        drift = health_ctx.get("deriva_percentual", 0.0)
        microstops = health_ctx.get("microparadas_na_janela", 0)
        cycle_drift = drift > 15.0
        spike = microstops >= 5

        risk = "CRITICO" if (cycle_drift and spike) else ("ATENCAO" if (cycle_drift or spike) else "NORMAL")
        inspections = []
        if cycle_drift:
            inspections.append("Inspecionar pressão de vácuo/ventosas da garra e lubrificação de eixos do robô.")
        if spike:
            inspections.append("Verificar alinhamento de sensores fotoelétricos e guias das esteiras.")

        return PredictiveHealthReport(
            line_id=line_id,
            risk_level=risk,
            cycle_drift_detected=cycle_drift,
            microstop_spike_detected=spike,
            summary=f"[MODO OFFLINE] Deriva de ciclo: {drift:.1f}% | Microparadas na janela: {microstops}.",
            recommended_inspections=inspections,
            missing_variables=[],
        )
Como plugar: No app/agent/nexpulse_agent.py, envolva a chamada self.client.aio.models.generate_content(...) em um try/except (httpx.ConnectError, Exception): se falhar por falta de rede/API, chame OfflineAgentFallback.try_local_ollama(...) ou o fallback determinístico correspondente!
