6. Motores de Regras Industriais
app/services/state_engine.py
Este é o cérebro operacional: mantém contexto isolado por line_id protegido por asyncio.Lock, trata rollover/reset de CLP, gerencia abertura/fechamento de paradas, detecta anomalias de formação do palete e calcula degradação preditiva de ciclo via EWMA.
Python
import asyncio
import uuid
from dataclasses import dataclass
from datetime import datetime, timezone
from typing import Dict, Optional
import structlog
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.config import settings
from app.db.models import (
    AnomalyAlert, DowntimeEvent, DowntimeTypeEnum, MachineStateEnum,
    PalletRecord, PalletStatusEnum, ProductRecipe
)
from app.schemas.telemetry import PLCTelemetryPayload

logger = structlog.get_logger()


@dataclass
class LineRuntimeContext:
    last_payload: Optional[PLCTelemetryPayload] = None
    open_downtime_id: Optional[int] = None
    open_downtime_start: Optional[datetime] = None
    active_pallet_id: Optional[int] = None
    active_pallet_boxes: int = 0
    ewma_cycle_sec: float = 0.0
    degradation_streak: int = 0
    last_alert_at: Optional[datetime] = None


class StateAndPalletEngine:
    def __init__(self) -> None:
        self._contexts: Dict[str, LineRuntimeContext] = {}
        self._locks: Dict[str, asyncio.Lock] = {}

    def _get_lock(self, line_id: str) -> asyncio.Lock:
        if line_id not in self._locks:
            self._locks[line_id] = asyncio.Lock()
        return self._locks[line_id]

    async def process_telemetry(
        self, session: AsyncSession, payload: PLCTelemetryPayload
    ) -> dict:
        """
        Processa telemetria com atomicidade por linha.
        Retorna snapshot enriquecido para cache Redis e broadcast WebSocket.
        """
        lock = self._get_lock(payload.line_id)
        async with lock:
            ctx = self._contexts.setdefault(payload.line_id, LineRuntimeContext())
            prev = ctx.last_payload

            # Descarta pacotes fora de ordem (Store-and-Forward atrasado não corrompe estado atual)
            if prev and payload.timestamp < prev.timestamp:
                logger.warning(
                    "out_of_order_telemetry_skipped",
                    line_id=payload.line_id,
                    msg_ts=payload.timestamp.isoformat(),
                    last_ts=prev.timestamp.isoformat(),
                )
                return {}

            recipe = await self._get_recipe(session, payload.sku)
            target_boxes = (recipe.boxes_per_layer * recipe.total_layers) if recipe else 0

            # 1. Máquina de Estados & Gestão de Paradas
            await self._handle_state_transition(session, ctx, prev, payload)

            # 2. Formação do Palete & Detecção de Erros de Contagem
            await self._handle_pallet_tracking(session, ctx, prev, payload, recipe)

            # 3. Análise Preditiva de Degradação do Tempo de Ciclo (EWMA)
            await self._handle_cycle_ewma(session, ctx, payload, recipe)

            ctx.last_payload = payload
            await session.commit()

            return {
                "line_id": payload.line_id,
                "timestamp": payload.timestamp.isoformat(),
                "machine_state": payload.machine_state,
                "machine_state_label": MachineStateEnum(payload.machine_state).name,
                "robot_status": payload.robot_status,
                "conveyor_in_ok": payload.conveyor_in_ok,
                "conveyor_out_ok": payload.conveyor_out_ok,
                "sku": payload.sku,
                "boxes_shift": payload.boxes_shift,
                "completed_pallets": payload.completed_pallets,
                "current_layer": payload.current_layer,
                "total_layers": recipe.total_layers if recipe else 0,
                "boxes_in_layer": payload.boxes_in_layer,
                "boxes_per_layer": recipe.boxes_per_layer if recipe else 0,
                "active_pallet_boxes": ctx.active_pallet_boxes,
                "target_pallet_boxes": target_boxes,
                "cycle_time_sec": payload.cycle_time_sec,
                "ewma_cycle_sec": round(ctx.ewma_cycle_sec, 2),
                "alarm_code": payload.alarm_code,
                "alarm_description": payload.alarm_description,
                "in_downtime": ctx.open_downtime_id is not None,
            }

    async def _get_recipe(self, session: AsyncSession, sku: str) -> Optional[ProductRecipe]:
        res = await session.execute(select(ProductRecipe).where(ProductRecipe.sku == sku))
        return res.scalar_one_or_none()

    async def _handle_state_transition(
        self,
        session: AsyncSession,
        ctx: LineRuntimeContext,
        prev: Optional[PLCTelemetryPayload],
        curr: PLCTelemetryPayload,
    ) -> None:
        is_stopped = curr.machine_state != MachineStateEnum.RUNNING.value

        # Caso 1: Entrou em parada agora (ou mudou o tipo de parada/alarme)
        if is_stopped and ctx.open_downtime_id is None:
            dtype = (
                DowntimeTypeEnum.FAULT
                if curr.machine_state == MachineStateEnum.FAULT.value
                else DowntimeTypeEnum.MICROSTOP
            )
            ev = DowntimeEvent(
                line_id=curr.line_id,
                machine_state=curr.machine_state,
                downtime_type=dtype,
                alarm_code=curr.alarm_code,
                alarm_description=curr.alarm_description,
                started_at=curr.timestamp,
            )
            session.add(ev)
            await session.flush()
            ctx.open_downtime_id = ev.id
            ctx.open_downtime_start = curr.timestamp
            logger.info("downtime_opened", line_id=curr.line_id, downtime_id=ev.id, state=curr.machine_state)

        # Caso 2: Continua parado — atualiza classificação se ultrapassou limiar de microparada
        elif is_stopped and ctx.open_downtime_id is not None and ctx.open_downtime_start:
            elapsed = (curr.timestamp - ctx.open_downtime_start).total_seconds()
            if elapsed >= settings.MICROSTOP_THRESHOLD_SEC:
                ev = await session.get(DowntimeEvent, ctx.open_downtime_id)
                if ev and ev.downtime_type == DowntimeTypeEnum.MICROSTOP:
                    ev.downtime_type = DowntimeTypeEnum.MACROSTOP

        # Caso 3: Voltou a operar — fecha o evento de parada com duração exata
        elif not is_stopped and ctx.open_downtime_id is not None:
            ev = await session.get(DowntimeEvent, ctx.open_downtime_id)
            if ev:
                duration = max(0.0, (curr.timestamp - ev.started_at).total_seconds())
                ev.ended_at = curr.timestamp
                ev.duration_sec = round(duration, 2)
                if ev.downtime_type == DowntimeTypeEnum.MICROSTOP and duration >= settings.MICROSTOP_THRESHOLD_SEC:
                    ev.downtime_type = DowntimeTypeEnum.MACROSTOP
                logger.info("downtime_closed", line_id=curr.line_id, downtime_id=ev.id, duration_sec=duration)
            ctx.open_downtime_id = None
            ctx.open_downtime_start = None

    async def _handle_pallet_tracking(
        self,
        session: AsyncSession,
        ctx: LineRuntimeContext,
        prev: Optional[PLCTelemetryPayload],
        curr: PLCTelemetryPayload,
        recipe: Optional[ProductRecipe],
    ) -> None:
        target_boxes = (recipe.boxes_per_layer * recipe.total_layers) if recipe else 0

        # Inicia novo palete rastreado se ainda não houver um aberto
        if ctx.active_pallet_id is None:
            pallet = PalletRecord(
                line_id=curr.line_id,
                pallet_uid=f"{curr.line_id}-{curr.timestamp.strftime('%Y%m%d%H%M%S')}-{uuid.uuid4().hex[:6]}",
                sku=curr.sku,
                target_boxes=target_boxes,
                actual_boxes=0,
                max_layer_reached=curr.current_layer,
                status=PalletStatusEnum.IN_PROGRESS,
                started_at=curr.timestamp,
            )
            session.add(pallet)
            await session.flush()
            ctx.active_pallet_id = pallet.id
            ctx.active_pallet_boxes = 0

        if prev is None:
            return

        # Delta seguro contra reset de contador no CLP (troca de turno / queda de energia)
        if curr.boxes_shift >= prev.boxes_shift:
            delta_boxes = curr.boxes_shift - prev.boxes_shift
        else:
            delta_boxes = curr.boxes_shift
            logger.info("plc_counter_rollover_detected", line_id=curr.line_id, new_val=curr.boxes_shift)

        ctx.active_pallet_boxes += delta_boxes

        active_pallet = await session.get(PalletRecord, ctx.active_pallet_id)
        if not active_pallet:
            return

        active_pallet.actual_boxes = ctx.active_pallet_boxes
        active_pallet.max_layer_reached = max(active_pallet.max_layer_reached, curr.current_layer)

        # Validação de integridade da receita (Formação do Palete)
        if recipe:
            if curr.boxes_in_layer > recipe.boxes_per_layer or curr.current_layer > recipe.total_layers:
                await self._emit_alert(
                    session, ctx, curr.line_id, "PALLET_PATTERN_ANOMALY", "CRITICAL",
                    f"Excesso detectado no padrão do SKU {curr.sku}: Camada {curr.current_layer}/{recipe.total_layers}, "
                    f"Caixas na camada {curr.boxes_in_layer}/{recipe.boxes_per_layer}.",
                    {"sku": curr.sku, "layer": curr.current_layer, "boxes_in_layer": curr.boxes_in_layer},
                    curr.timestamp,
                )

        # Troca de SKU com palete aberto no meio -> Aborta palete anterior
        if curr.sku != prev.sku and ctx.active_pallet_boxes > 0:
            active_pallet.status = PalletStatusEnum.INCOMPLETE_ABORTED
            active_pallet.completed_at = curr.timestamp
            await self._emit_alert(
                session, ctx, curr.line_id, "SKU_CHANGED_MID_PALLET", "WARNING",
                f"Troca de SKU ({prev.sku} -> {curr.sku}) antes da conclusão do palete.",
                {"pallet_uid": active_pallet.pallet_uid},
                curr.timestamp,
            )
            ctx.active_pallet_id = None
            ctx.active_pallet_boxes = 0
            return

        # Conclusão do palete (incremento no contador do CLP)
        if curr.completed_pallets > prev.completed_pallets:
            if target_boxes > 0 and active_pallet.actual_boxes > target_boxes:
                active_pallet.status = PalletStatusEnum.OVERCOUNT_ANOMALY
            elif target_boxes > 0 and active_pallet.actual_boxes < target_boxes:
                active_pallet.status = PalletStatusEnum.INCOMPLETE_ABORTED
            else:
                active_pallet.status = PalletStatusEnum.COMPLETE
            active_pallet.completed_at = curr.timestamp
            ctx.active_pallet_id = None
            ctx.active_pallet_boxes = 0

    async def _handle_cycle_ewma(
        self,
        session: AsyncSession,
        ctx: LineRuntimeContext,
        curr: PLCTelemetryPayload,
        recipe: Optional[ProductRecipe],
    ) -> None:
        if curr.machine_state != MachineStateEnum.RUNNING.value or curr.cycle_time_sec <= 0:
            return

        if ctx.ewma_cycle_sec == 0.0:
            ctx.ewma_cycle_sec = curr.cycle_time_sec
        else:
            alpha = settings.EWMA_ALPHA
            ctx.ewma_cycle_sec = alpha * curr.cycle_time_sec + (1.0 - alpha) * ctx.ewma_cycle_sec

        if recipe and ctx.ewma_cycle_sec > recipe.ideal_cycle_sec * settings.CYCLE_DEGRADATION_FACTOR:
            ctx.degradation_streak += 1
            if ctx.degradation_streak >= 10:
                await self._emit_alert(
                    session, ctx, curr.line_id, "CYCLE_TIME_DEGRADATION", "WARNING",
                    f"Degradação no tempo de ciclo: EWMA {ctx.ewma_cycle_sec:.2f}s vs Ideal {recipe.ideal_cycle_sec:.2f}s.",
                    {"ewma": round(ctx.ewma_cycle_sec, 2), "ideal": recipe.ideal_cycle_sec},
                    curr.timestamp,
                )
                ctx.degradation_streak = 0
        else:
            ctx.degradation_streak = 0

    async def _emit_alert(
        self,
        session: AsyncSession,
        ctx: LineRuntimeContext,
        line_id: str,
        alert_type: str,
        severity: str,
        message: str,
        metadata: dict,
        now: datetime,
    ) -> None:
        # Throttling de alertas (evita flood no banco em condições persistentes)
        if ctx.last_alert_at and (now - ctx.last_alert_at).total_seconds() < 30:
            return
        ctx.last_alert_at = now
        session.add(
            AnomalyAlert(
                line_id=line_id,
                alert_type=alert_type,
                severity=severity,
                message=message,
                metadata_json=metadata,
                created_at=now,
            )
        )
