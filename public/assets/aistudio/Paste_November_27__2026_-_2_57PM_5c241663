import asyncio
import json
from typing import List
import aiomqtt
import structlog
from redis.asyncio import Redis
from sqlalchemy.dialects.postgresql import insert as pg_insert

from app.core.config import settings
from app.db.models import TelemetryPoint
from app.db.session import AsyncSessionLocal
from app.schemas.telemetry import PLCTelemetryPayload
from app.services.state_engine import StateAndPalletEngine

logger = structlog.get_logger()


class IndustrialIngestionPipeline:
    def __init__(self, redis_client: Redis) -> None:
        self.redis = redis_client
        self.state_engine = StateAndPalletEngine()
        self.queue: asyncio.Queue[PLCTelemetryPayload] = asyncio.Queue(maxsize=5000)
        self.ts_buffer: List[dict] = []
        self._running = False
        self._tasks: List[asyncio.Task] = []

    async def start(self) -> None:
        self._running = True
        self._tasks = [
            asyncio.create_task(self._mqtt_consumer_loop()),
            asyncio.create_task(self._processing_worker()),
            asyncio.create_task(self._batch_writer_loop()),
        ]
        logger.info("ingestion_pipeline_started")

    async def stop(self) -> None:
        self._running = False
        for t in self._tasks:
            t.cancel()
        await asyncio.gather(*self._tasks, return_exceptions=True)
        await self._flush_timeseries()
        logger.info("ingestion_pipeline_stopped")

    async def _mqtt_consumer_loop(self) -> None:
        backoff = 1
        while self._running:
            try:
                async with aiomqtt.Client(hostname=settings.MQTT_HOST, port=settings.MQTT_PORT) as client:
                    await client.subscribe(settings.MQTT_TOPIC, qos=1)
                    logger.info("mqtt_connected", topic=settings.MQTT_TOPIC)
                    backoff = 1
                    async for message in client.messages:
                        try:
                            raw = json.loads(message.payload.decode("utf-8"))
                            payload = PLCTelemetryPayload.model_validate(raw)
                            await self.queue.put(payload)
                        except Exception as exc:
                            logger.error("invalid_mqtt_payload", error=str(exc), topic=message.topic.value)
            except aiomqtt.MqttError as exc:
                logger.warning("mqtt_connection_lost_retrying", error=str(exc), backoff_sec=backoff)
                await asyncio.sleep(backoff)
                backoff = min(30, backoff * 2)

    async def _processing_worker(self) -> None:
        while self._running:
            payload = await self.queue.get()
            try:
                async with AsyncSessionLocal() as session:
                    snapshot = await self.state_engine.process_telemetry(session, payload)

                if snapshot:
                    # 1. Atualiza Cache Quente no Redis (para carregamento instantâneo da tela)
                    await self.redis.set(f"line:state:{payload.line_id}", json.dumps(snapshot), ex=300)
                    # 2. Publica em tempo real via Redis Pub/Sub para todos os WebSockets conectados
                    await self.redis.publish(f"ws:line:{payload.line_id}", json.dumps(snapshot))

                    # 3. Enfileira ponto para gravação em lote no TimescaleDB
                    self.ts_buffer.append(
                        {
                            "time": payload.timestamp,
                            "line_id": payload.line_id,
                            "machine_state": payload.machine_state,
                            "robot_status": payload.robot_status,
                            "conveyor_in_ok": payload.conveyor_in_ok,
                            "conveyor_out_ok": payload.conveyor_out_ok,
                            "sku": payload.sku,
                            "boxes_shift": payload.boxes_shift,
                            "completed_pallets": payload.completed_pallets,
                            "current_layer": payload.current_layer,
                            "boxes_in_layer": payload.boxes_in_layer,
                            "cycle_time_sec": payload.cycle_time_sec,
                            "ewma_cycle_sec": snapshot["ewma_cycle_sec"],
                            "alarm_code": payload.alarm_code,
                        }
                    )
                    if len(self.ts_buffer) >= settings.BATCH_MAX_SIZE:
                        await self._flush_timeseries()
            except Exception as exc:
                logger.exception("processing_worker_error", error=str(exc))
            finally:
                self.queue.task_done()

    async def _batch_writer_loop(self) -> None:
        while self._running:
            await asyncio.sleep(settings.BATCH_FLUSH_INTERVAL_SEC)
            if self.ts_buffer:
                await self._flush_timeseries()

    async def _flush_timeseries(self) -> None:
        if not self.ts_buffer:
            return
        batch = self.ts_buffer[:]
        self.ts_buffer.clear()
        try:
            async with AsyncSessionLocal() as session:
                stmt = pg_insert(TelemetryPoint).values(batch).on_conflict_do_nothing(
                    index_elements=["line_id", "time"]
                )
                await session.execute(stmt)
                await session.commit()
        except Exception as exc:
            logger.error("batch_timeseries_flush_failed", count=len(batch), error=str(exc))
