import asyncio
from fastapi import APIRouter, WebSocket, WebSocketDisconnect
from redis.asyncio import Redis

router = APIRouter()


@router.websocket("/ws/lines/{line_id}")
async def line_realtime_ws(websocket: WebSocket, line_id: str) -> None:
    await websocket.accept()
    redis: Redis = websocket.app.state.redis

    # Envia último estado em cache imediatamente na conexão
    cached = await redis.get(f"line:state:{line_id}")
    if cached:
        await websocket.send_text(cached.decode("utf-8") if isinstance(cached, bytes) else cached)

    pubsub = redis.pubsub()
    await pubsub.subscribe(f"ws:line:{line_id}")

    try:
        while True:
            message = await pubsub.get_message(ignore_subscribe_messages=True, timeout=1.0)
            if message and message["data"]:
                data = message["data"]
                await websocket.send_text(data.decode("utf-8") if isinstance(data, bytes) else data)
            await asyncio.sleep(0.05)
    except WebSocketDisconnect:
        pass
    finally:
        await pubsub.unsubscribe(f"ws:line:{line_id}")
        await pubsub.close()
