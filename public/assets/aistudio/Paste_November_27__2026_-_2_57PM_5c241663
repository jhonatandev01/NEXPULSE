import asyncio
import json
import random
from datetime import datetime, timezone
import aiomqtt


async def run_plc_simulator() -> None:
    line_id = "PAL-01"
    sku = "CX-BEBIDA-12X1L"
    boxes_per_layer = 8
    total_layers = 4

    boxes_shift = 0
    completed_pallets = 0
    current_layer = 1
    boxes_in_layer = 0
    tick = 0

    async with aiomqtt.Client("localhost", 1883) as client:
        print("Simulador de CLP conectado ao MQTT. Publicando telemetria...")
        while True:
            tick += 1
            # Simula falha no robô entre os ticks 35 e 45
            if 35 <= tick <= 45:
                state, robot, alarm, desc, cycle = 5, 5, 402, "FALHA GARRA VACUO ROBO", 0.0
            else:
                state, robot, alarm, desc = 1, 1, 0, None
                # Simula degradação gradual de ciclo após tick 50
                cycle = 2.8 if tick < 50 else round(random.uniform(3.8, 4.4), 2)
                boxes_shift += 1
                boxes_in_layer += 1
                if boxes_in_layer > boxes_per_layer:
                    boxes_in_layer = 1
                    current_layer += 1
                    if current_layer > total_layers:
                        current_layer = 1
                        completed_pallets += 1

            payload = {
                "line_id": line_id,
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "machine_state": state,
                "robot_status": robot,
                "conveyor_in_ok": True,
                "conveyor_out_ok": True,
                "sku": sku,
                "boxes_shift": boxes_shift,
                "completed_pallets": completed_pallets,
                "current_layer": current_layer,
                "boxes_in_layer": boxes_in_layer,
                "cycle_time_sec": cycle,
                "alarm_code": alarm,
                "alarm_description": desc,
            }
            await client.publish(
                f"fabrica/expedicao/{line_id}/telemetria",
                json.dumps(payload),
                qos=1,
            )
            print(f"[TX] caixas={boxes_shift} paletes={completed_pallets} camada={current_layer} state={state}")
            await asyncio.sleep(1.0)


if __name__ == "__main__":
    asyncio.run(run_plc_simulator())
