from datetime import datetime
from sqlalchemy import and_, func, select
from sqlalchemy.ext.asyncio import AsyncSession

from app.db.models import (
    DowntimeEvent, PalletRecord, PalletStatusEnum, ProductRecipe, ReasonCode, TelemetryPoint
)
from app.schemas.telemetry import OEEResponse


class OEEAnalyticsEngine:
    @staticmethod
    async def calculate_oee(
        session: AsyncSession, line_id: str, start: datetime, end: datetime
    ) -> OEEResponse:
        total_window_sec = max(1.0, (end - start).total_seconds())

        # 1. Soma paradas planejadas e não planejadas que interceptam a janela
        downtime_stmt = (
            select(DowntimeEvent, ReasonCode)
            .outerjoin(ReasonCode, DowntimeEvent.reason_code_id == ReasonCode.id)
            .where(
                and_(
                    DowntimeEvent.line_id == line_id,
                    DowntimeEvent.started_at < end,
                    (DowntimeEvent.ended_at.is_(None)) | (DowntimeEvent.ended_at > start),
                )
            )
        )
        rows = (await session.execute(downtime_stmt)).all()

        planned_stop_sec = 0.0
        unplanned_stop_sec = 0.0
        for ev, reason in rows:
            ev_start = max(start, ev.started_at)
            ev_end = min(end, ev.ended_at or end)
            dur = max(0.0, (ev_end - ev_start).total_seconds())
            if reason and reason.is_planned_stop:
                planned_stop_sec += dur
            else:
                unplanned_stop_sec += dur

        planned_time_sec = max(1.0, total_window_sec - planned_stop_sec)
        running_time_sec = max(0.0, planned_time_sec - unplanned_stop_sec)
        availability = min(1.0, running_time_sec / planned_time_sec)

        # 2. Total de caixas produzidas na janela (via paletes rastreados + deltas)
        pallet_stmt = select(PalletRecord).where(
            and_(
                PalletRecord.line_id == line_id,
                PalletRecord.started_at >= start,
                PalletRecord.started_at <= end,
            )
        )
        pallets = (await session.execute(pallet_stmt)).scalars().all()
        total_boxes = sum(p.actual_boxes for p in pallets)
        completed_count = sum(1 for p in pallets if p.status != PalletStatusEnum.IN_PROGRESS)
        valid_boxes = sum(
            p.actual_boxes for p in pallets if p.status in (PalletStatusEnum.COMPLETE, PalletStatusEnum.IN_PROGRESS)
        )

        # 3. Performance ponderada pelo ciclo ideal das receitas usadas
        ideal_time_earned_sec = 0.0
        recipes_cache: dict[str, float] = {}
        for p in pallets:
            if p.sku not in recipes_cache:
                r = (await session.execute(select(ProductRecipe).where(ProductRecipe.sku == p.sku))).scalar_one_or_none()
                recipes_cache[p.sku] = r.ideal_cycle_sec if r else 4.0
            ideal_time_earned_sec += p.actual_boxes * recipes_cache[p.sku]

        performance = min(1.0, ideal_time_earned_sec / running_time_sec) if running_time_sec > 0 else 0.0
        quality = (valid_boxes / total_boxes) if total_boxes > 0 else 1.0
        oee = availability * performance * quality

        return OEEResponse(
            line_id=line_id,
            window_start=start,
            window_end=end,
            availability=round(availability * 100, 2),
            performance=round(performance * 100, 2),
            quality=round(quality * 100, 2),
            oee=round(oee * 100, 2),
            total_boxes=total_boxes,
            total_pallets=completed_count,
            planned_time_sec=round(planned_time_sec, 1),
            running_time_sec=round(running_time_sec, 1),
            downtime_sec=round(unplanned_stop_sec, 1),
        )

    @staticmethod
    async def get_pareto_downtimes(
        session: AsyncSession, line_id: str, start: datetime, end: datetime, limit: int = 5
    ) -> list[dict]:
        stmt = (
            select(
                func.coalesce(ReasonCode.description, "Não Justificada / Falha Automática").label("reason"),
                func.count(DowntimeEvent.id).label("occurrences"),
                func.sum(func.coalesce(DowntimeEvent.duration_sec, 0.0)).label("total_duration_sec"),
            )
            .outerjoin(ReasonCode, DowntimeEvent.reason_code_id == ReasonCode.id)
            .where(
                and_(
                    DowntimeEvent.line_id == line_id,
                    DowntimeEvent.started_at >= start,
                    DowntimeEvent.started_at <= end,
                )
            )
            .group_by("reason")
            .order_by(func.sum(func.coalesce(DowntimeEvent.duration_sec, 0.0)).desc())
            .limit(limit)
        )
        rows = (await session.execute(stmt)).all()
        return [
            {
                "reason": r.reason,
                "occurrences": r.occurrences,
                "total_duration_sec": round(float(r.total_duration_sec), 1),
            }
            for r in rows
        ]
